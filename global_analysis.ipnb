import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score


# ============================================================
# 1. INPUT / OUTPUT SETTINGS
# ============================================================

INPUT_CSV = r"C:\Users\ishin\OneDrive\Desktop\ish\gbm_thickness_summary.csv"

OUTPUT_FOLDER = r"C:\Users\ishin\OneDrive\Desktop\ish\Global_GBM_Analysis"

os.makedirs(OUTPUT_FOLDER, exist_ok=True)


# ============================================================
# 2. CHECK INPUT FILE
# ============================================================

if not os.path.exists(INPUT_CSV):

    raise FileNotFoundError(
        f"\nInput file not found:\n{INPUT_CSV}"
    )


# ============================================================
# 3. LOAD DATA
# ============================================================

df = pd.read_csv(INPUT_CSV)


print()
print("=" * 80)
print("GLOBAL GBM THICKNESS ANALYSIS")
print("=" * 80)

print(
    f"Total membrane components : {len(df)}"
)

print(
    f"Patients                  : "
    f"{df['patient_id'].nunique()}"
)

print("=" * 80)


# ============================================================
# 4. CHECK REQUIRED COLUMNS
# ============================================================

required_columns = [

    "component_id",
    "mean_thickness_nm",
    "median_thickness_nm",
    "std_thickness_nm",
    "min_thickness_nm",
    "max_thickness_nm",
    "number_of_measurements",
    "patient_id"

]

missing_columns = [

    column

    for column in required_columns

    if column not in df.columns

]


if missing_columns:

    raise ValueError(
        "\nMissing required columns:\n"
        + "\n".join(missing_columns)
    )


# ============================================================
# 5. REMOVE INVALID VALUES
# ============================================================

df = df.dropna(
    subset=[
        "mean_thickness_nm",
        "median_thickness_nm",
        "std_thickness_nm",
        "min_thickness_nm",
        "max_thickness_nm",
        "patient_id"
    ]
).copy()


# ============================================================
# 6. GLOBAL DESCRIPTIVE STATISTICS
# ============================================================

thickness = df["median_thickness_nm"]


global_statistics = {

    "Total_patients":
        df["patient_id"].nunique(),

    "Total_membrane_components":
        len(df),

    "Mean_median_thickness_nm":
        thickness.mean(),

    "Median_of_median_thickness_nm":
        thickness.median(),

    "SD_median_thickness_nm":
        thickness.std(),

    "Minimum_median_thickness_nm":
        thickness.min(),

    "Maximum_median_thickness_nm":
        thickness.max(),

    "Q1_median_thickness_nm":
        thickness.quantile(0.25),

    "Q3_median_thickness_nm":
        thickness.quantile(0.75),

    "IQR_median_thickness_nm":
        thickness.quantile(0.75)
        - thickness.quantile(0.25)

}


global_df = pd.DataFrame(
    list(global_statistics.items()),
    columns=["Statistic", "Value"]
)


global_file = os.path.join(
    OUTPUT_FOLDER,
    "Global_descriptive_statistics.csv"
)

global_df.to_csv(
    global_file,
    index=False
)


print()
print("GLOBAL STATISTICS")
print("-" * 80)

print(
    f"Mean thickness   : "
    f"{thickness.mean():.2f} nm"
)

print(
    f"Median thickness : "
    f"{thickness.median():.2f} nm"
)

print(
    f"SD               : "
    f"{thickness.std():.2f} nm"
)

print(
    f"Minimum          : "
    f"{thickness.min():.2f} nm"
)

print(
    f"Maximum          : "
    f"{thickness.max():.2f} nm"
)

print(
    f"Q1               : "
    f"{thickness.quantile(0.25):.2f} nm"
)

print(
    f"Q3               : "
    f"{thickness.quantile(0.75):.2f} nm"
)


# ============================================================
# 7. PATIENT-LEVEL STATISTICS
# ============================================================

patient_statistics = (

    df.groupby("patient_id")

    .agg(

        Number_of_membranes=(
            "component_id",
            "count"
        ),

        Mean_thickness_nm=(
            "median_thickness_nm",
            "mean"
        ),

        Median_thickness_nm=(
            "median_thickness_nm",
            "median"
        ),

        SD_thickness_nm=(
            "median_thickness_nm",
            "std"
        ),

        Minimum_thickness_nm=(
            "median_thickness_nm",
            "min"
        ),

        Maximum_thickness_nm=(
            "median_thickness_nm",
            "max"
        )

    )

    .reset_index()

)


patient_statistics = patient_statistics.sort_values(
    "Mean_thickness_nm"
).reset_index(drop=True)


patient_file = os.path.join(
    OUTPUT_FOLDER,
    "Patient_level_statistics.csv"
)

patient_statistics.to_csv(
    patient_file,
    index=False
)


print()
print("PATIENT-LEVEL STATISTICS")
print("-" * 80)

print(
    patient_statistics.to_string(
        index=False
    )
)


# ============================================================
# 8. GLOBAL HISTOGRAM
# ============================================================

fig, ax = plt.subplots(
    figsize=(11, 7)
)

ax.hist(
    thickness,
    bins=25,
    density=True,
    alpha=0.65,
    edgecolor="black"
)

ax.axvline(
    thickness.mean(),
    linestyle="--",
    linewidth=2,
    label=f"Mean = {thickness.mean():.1f} nm"
)

ax.axvline(
    thickness.median(),
    linestyle=":",
    linewidth=2,
    label=f"Median = {thickness.median():.1f} nm"
)

ax.set_xlabel(
    "GBM median thickness (nm)",
    fontsize=12
)

ax.set_ylabel(
    "Density",
    fontsize=12
)

ax.set_title(
    "Global Distribution of GBM Membrane Thickness",
    fontsize=14,
    fontweight="bold"
)

ax.legend()

ax.grid(
    True,
    alpha=0.2,
    linestyle="--"
)

plt.tight_layout()

global_histogram = os.path.join(
    OUTPUT_FOLDER,
    "Figure_1_Global_Thickness_Distribution.png"
)

plt.savefig(
    global_histogram,
    dpi=300,
    bbox_inches="tight"
)

plt.close(fig)


# ============================================================
# 9. PATIENT-WISE BOXPLOT
# ============================================================

patient_order = (

    patient_statistics
    .sort_values("Median_thickness_nm")
    ["patient_id"]
    .tolist()

)


box_data = [

    df.loc[
        df["patient_id"] == patient,
        "median_thickness_nm"
    ].values

    for patient in patient_order

]


fig, ax = plt.subplots(
    figsize=(13, 7)
)


ax.boxplot(
    box_data,
    labels=patient_order,
    patch_artist=True
)


ax.set_xlabel(
    "Patient ID",
    fontsize=12
)

ax.set_ylabel(
    "GBM median thickness (nm)",
    fontsize=12
)

ax.set_title(
    "Patient-wise Distribution of GBM Thickness",
    fontsize=14,
    fontweight="bold"
)

ax.grid(
    True,
    axis="y",
    alpha=0.2,
    linestyle="--"
)

plt.xticks(
    rotation=45
)

plt.tight_layout()


patient_boxplot = os.path.join(
    OUTPUT_FOLDER,
    "Figure_2_Patient_Wise_Boxplot.png"
)

plt.savefig(
    patient_boxplot,
    dpi=300,
    bbox_inches="tight"
)

plt.close(fig)


# ============================================================
# 10. FEATURES FOR PCA AND CLUSTERING
# ============================================================

feature_columns = [

    "mean_thickness_nm",
    "median_thickness_nm",
    "std_thickness_nm",
    "min_thickness_nm",
    "max_thickness_nm"

]


X = df[feature_columns].copy()


# ============================================================
# 11. STANDARDIZATION
# ============================================================

scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)


# ============================================================
# 12. PCA
# ============================================================

pca = PCA(
    n_components=2
)

X_pca = pca.fit_transform(
    X_scaled
)


df["PC1"] = X_pca[:, 0]
df["PC2"] = X_pca[:, 1]


explained_variance = (
    pca.explained_variance_ratio_
    * 100
)


print()
print("PCA RESULTS")
print("-" * 80)

print(
    f"PC1 explained variance : "
    f"{explained_variance[0]:.2f}%"
)

print(
    f"PC2 explained variance : "
    f"{explained_variance[1]:.2f}%"
)

print(
    f"Total explained        : "
    f"{explained_variance.sum():.2f}%"
)


# ============================================================
# 13. PCA PLOT BEFORE CLUSTERING
# ============================================================

fig, ax = plt.subplots(
    figsize=(10, 7)
)

ax.scatter(
    df["PC1"],
    df["PC2"],
    alpha=0.70,
    s=45
)

ax.set_xlabel(
    f"PC1 ({explained_variance[0]:.1f}% variance)",
    fontsize=12
)

ax.set_ylabel(
    f"PC2 ({explained_variance[1]:.1f}% variance)",
    fontsize=12
)

ax.set_title(
    "PCA Projection of GBM Membrane Components",
    fontsize=14,
    fontweight="bold"
)

ax.grid(
    True,
    alpha=0.2,
    linestyle="--"
)

plt.tight_layout()


pca_raw_file = os.path.join(
    OUTPUT_FOLDER,
    "Figure_3_PCA_Projection.png"
)

plt.savefig(
    pca_raw_file,
    dpi=300,
    bbox_inches="tight"
)

plt.close(fig)


# ============================================================
# 14. DETERMINE OPTIMAL NUMBER OF CLUSTERS
# ============================================================

print()
print("CLUSTER OPTIMIZATION")
print("-" * 80)


cluster_results = []


max_clusters = min(
    6,
    len(df) - 1
)


for k in range(2, max_clusters + 1):

    kmeans = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=20
    )

    labels = kmeans.fit_predict(
        X_scaled
    )

    silhouette = silhouette_score(
        X_scaled,
        labels
    )

    inertia = kmeans.inertia_

    cluster_results.append({

        "Number_of_clusters": k,

        "Silhouette_score":
            silhouette,

        "Within_cluster_SSE":
            inertia

    })

    print(
        f"k = {k} | "
        f"Silhouette = {silhouette:.4f} | "
        f"SSE = {inertia:.2f}"
    )


cluster_evaluation = pd.DataFrame(
    cluster_results
)


cluster_evaluation_file = os.path.join(
    OUTPUT_FOLDER,
    "Cluster_optimization.csv"
)

cluster_evaluation.to_csv(
    cluster_evaluation_file,
    index=False
)


# ============================================================
# 15. SELECT BEST NUMBER OF CLUSTERS
# ============================================================

best_k = int(

    cluster_evaluation.loc[
        cluster_evaluation[
            "Silhouette_score"
        ].idxmax(),
        "Number_of_clusters"
    ]

)


best_silhouette = (

    cluster_evaluation.loc[
        cluster_evaluation[
            "Number_of_clusters"
        ] == best_k,
        "Silhouette_score"
    ].iloc[0]

)


print()
print(
    f"Selected number of clusters : {best_k}"
)

print(
    f"Best silhouette score       : "
    f"{best_silhouette:.4f}"
)


# ============================================================
# 16. SILHOUETTE PLOT
# ============================================================

fig, ax = plt.subplots(
    figsize=(9, 6)
)

ax.plot(
    cluster_evaluation[
        "Number_of_clusters"
    ],
    cluster_evaluation[
        "Silhouette_score"
    ],
    marker="o",
    linewidth=2
)

ax.axvline(
    best_k,
    linestyle="--",
    linewidth=1.5,
    label=f"Selected k = {best_k}"
)

ax.set_xlabel(
    "Number of clusters",
    fontsize=12
)

ax.set_ylabel(
    "Silhouette score",
    fontsize=12
)

ax.set_title(
    "Cluster Number Selection",
    fontsize=14,
    fontweight="bold"
)

ax.set_xticks(
    cluster_evaluation[
        "Number_of_clusters"
    ]
)

ax.grid(
    True,
    alpha=0.2,
    linestyle="--"
)

ax.legend()

plt.tight_layout()


silhouette_file = os.path.join(
    OUTPUT_FOLDER,
    "Figure_4_Cluster_Optimization.png"
)

plt.savefig(
    silhouette_file,
    dpi=300,
    bbox_inches="tight"
)

plt.close(fig)


# ============================================================
# 17. FINAL K-MEANS CLUSTERING
# ============================================================

final_kmeans = KMeans(
    n_clusters=best_k,
    random_state=42,
    n_init=20
)


cluster_labels = final_kmeans.fit_predict(
    X_scaled
)


df["Cluster"] = cluster_labels + 1


# ============================================================
# 18. ORDER CLUSTERS BY THICKNESS
# ============================================================

cluster_order = (

    df.groupby("Cluster")[
        "median_thickness_nm"
    ]

    .mean()

    .sort_values()

    .index

    .tolist()

)


cluster_mapping = {

    old_cluster: new_cluster

    for new_cluster, old_cluster

    in enumerate(
        cluster_order,
        start=1
    )

}


df["Thickness_Group"] = (

    df["Cluster"]
    .map(cluster_mapping)

)


# Remove temporary cluster numbering

df.drop(
    columns=["Cluster"],
    inplace=True
)


# ============================================================
# 19. GIVE BIOLOGICALALLY NEUTRAL GROUP NAMES
# ============================================================

group_names = {}

for group in sorted(
    df["Thickness_Group"].unique()
):

    if group == 1:

        name = "Lower-thickness group"

    elif group == best_k:

        name = "Higher-thickness group"

    else:

        name = "Intermediate-thickness group"

    group_names[group] = name


df["Thickness_Group_Name"] = (

    df["Thickness_Group"]
    .map(group_names)

)


# ============================================================
# 20. CLUSTER / THICKNESS GROUP STATISTICS
# ============================================================

cluster_statistics = (

    df.groupby(
        [
            "Thickness_Group",
            "Thickness_Group_Name"
        ]
    )

    .agg(

        Number_of_membranes=(
            "component_id",
            "count"
        ),

        Mean_median_thickness_nm=(
            "median_thickness_nm",
            "mean"
        ),

        Median_median_thickness_nm=(
            "median_thickness_nm",
            "median"
        ),

        SD_median_thickness_nm=(
            "median_thickness_nm",
            "std"
        ),

        Minimum_thickness_nm=(
            "median_thickness_nm",
            "min"
        ),

        Maximum_thickness_nm=(
            "median_thickness_nm",
            "max"
        )

    )

    .reset_index()

)


cluster_statistics[
    "Percentage_of_membranes"
] = (

    cluster_statistics[
        "Number_of_membranes"
    ]

    / len(df)

    * 100

)


cluster_statistics = cluster_statistics.sort_values(
    "Thickness_Group"
)


cluster_statistics_file = os.path.join(
    OUTPUT_FOLDER,
    "Thickness_Group_Statistics.csv"
)

cluster_statistics.to_csv(
    cluster_statistics_file,
    index=False
)


print()
print("THICKNESS GROUP STATISTICS")
print("-" * 80)

print(
    cluster_statistics.to_string(
        index=False
    )
)


# ============================================================
# 21. PCA PLOT WITH CLUSTERS
# ============================================================

fig, ax = plt.subplots(
    figsize=(11, 8)
)


for group in sorted(
    df["Thickness_Group"].unique()
):

    subset = df[
        df["Thickness_Group"] == group
    ]

    label = group_names[group]

    ax.scatter(
        subset["PC1"],
        subset["PC2"],
        s=50,
        alpha=0.70,
        label=label
    )


ax.set_xlabel(
    f"PC1 ({explained_variance[0]:.1f}% variance)",
    fontsize=12
)

ax.set_ylabel(
    f"PC2 ({explained_variance[1]:.1f}% variance)",
    fontsize=12
)

ax.set_title(
    "PCA Projection of GBM Components by Thickness Group",
    fontsize=14,
    fontweight="bold"
)

ax.legend(
    title="Thickness group"
)

ax.grid(
    True,
    alpha=0.2,
    linestyle="--"
)

plt.tight_layout()


cluster_pca_file = os.path.join(
    OUTPUT_FOLDER,
    "Figure_5_PCA_Thickness_Groups.png"
)

plt.savefig(
    cluster_pca_file,
    dpi=300,
    bbox_inches="tight"
)

plt.close(fig)


# ============================================================
# 22. THICKNESS GROUP BOXPLOT
# ============================================================

group_order = sorted(
    df["Thickness_Group"].unique()
)


group_data = [

    df.loc[
        df["Thickness_Group"] == group,
        "median_thickness_nm"
    ].values

    for group in group_order

]


fig, ax = plt.subplots(
    figsize=(10, 7)
)


ax.boxplot(
    group_data,
    labels=[
        group_names[group]
        for group in group_order
    ],
    patch_artist=True
)


ax.set_xlabel(
    "Thickness group",
    fontsize=12
)

ax.set_ylabel(
    "GBM median thickness (nm)",
    fontsize=12
)

ax.set_title(
    "GBM Thickness Distribution Across Data-Driven Groups",
    fontsize=14,
    fontweight="bold"
)

ax.grid(
    True,
    axis="y",
    alpha=0.2,
    linestyle="--"
)

plt.tight_layout()


group_boxplot_file = os.path.join(
    OUTPUT_FOLDER,
    "Figure_6_Thickness_Group_Boxplot.png"
)

plt.savefig(
    group_boxplot_file,
    dpi=300,
    bbox_inches="tight"
)

plt.close(fig)


# ============================================================
# 23. PATIENT × THICKNESS GROUP TABLE
# ============================================================

patient_group_counts = pd.crosstab(

    df["patient_id"],

    df["Thickness_Group_Name"]

)


patient_group_percentages = (

    patient_group_counts

    .div(
        patient_group_counts.sum(axis=1),
        axis=0
    )

    * 100

)


patient_group_counts_file = os.path.join(
    OUTPUT_FOLDER,
    "Patient_Thickness_Group_Counts.csv"
)

patient_group_percentages_file = os.path.join(
    OUTPUT_FOLDER,
    "Patient_Thickness_Group_Percentages.csv"
)


patient_group_counts.to_csv(
    patient_group_counts_file
)

patient_group_percentages.to_csv(
    patient_group_percentages_file
)


print()
print("PATIENT × THICKNESS GROUP")
print("-" * 80)

print(
    patient_group_counts.to_string()
)


# ============================================================
# 24. PATIENT × THICKNESS GROUP STACKED BAR PLOT
# ============================================================

fig, ax = plt.subplots(
    figsize=(13, 7)
)


patient_group_percentages.plot(
    kind="bar",
    stacked=True,
    ax=ax
)


ax.set_xlabel(
    "Patient ID",
    fontsize=12
)

ax.set_ylabel(
    "Percentage of membrane components (%)",
    fontsize=12
)

ax.set_title(
    "Thickness-Group Composition Across Patients",
    fontsize=14,
    fontweight="bold"
)

ax.legend(
    title="Thickness group",
    bbox_to_anchor=(1.02, 1),
    loc="upper left"
)

ax.grid(
    True,
    axis="y",
    alpha=0.2,
    linestyle="--"
)

plt.xticks(
    rotation=45
)

plt.tight_layout()


patient_group_plot_file = os.path.join(
    OUTPUT_FOLDER,
    "Figure_7_Patient_Thickness_Group_Composition.png"
)

plt.savefig(
    patient_group_plot_file,
    dpi=300,
    bbox_inches="tight"
)

plt.close(fig)


# ============================================================
# 25. CLUSTER CENTERS IN ORIGINAL UNITS
# ============================================================

cluster_centers_scaled = (
    final_kmeans.cluster_centers_
)


cluster_centers_original = (

    scaler.inverse_transform(
        cluster_centers_scaled
    )

)


cluster_center_df = pd.DataFrame(
    cluster_centers_original,
    columns=feature_columns
)


cluster_center_df[
    "Thickness_Group"
] = [

    group

    for group in range(
        1,
        best_k + 1
    )

]


cluster_center_df[
    "Thickness_Group_Name"
] = [

    group_names[group]

    for group in range(
        1,
        best_k + 1
    )

]


cluster_center_df = cluster_center_df[
    [
        "Thickness_Group",
        "Thickness_Group_Name"
    ]
    + feature_columns
]


cluster_centers_file = os.path.join(
    OUTPUT_FOLDER,
    "Thickness_Group_Centers.csv"
)

cluster_center_df.to_csv(
    cluster_centers_file,
    index=False
)


# ============================================================
# 26. SAVE COMPONENT-LEVEL CLUSTER ASSIGNMENTS
# ============================================================

component_output_columns = [

    "component_id",
    "patient_id",
    "image_name",

    "mean_thickness_nm",
    "median_thickness_nm",
    "std_thickness_nm",
    "min_thickness_nm",
    "max_thickness_nm",

    "number_of_measurements",

    "PC1",
    "PC2",

    "Thickness_Group",
    "Thickness_Group_Name"

]


component_results = df[
    component_output_columns
].copy()


component_results = component_results.sort_values(
    [
        "Thickness_Group",
        "median_thickness_nm"
    ]
)


component_results_file = os.path.join(
    OUTPUT_FOLDER,
    "All_Component_Thickness_Group_Assignments.csv"
)

component_results.to_csv(
    component_results_file,
    index=False
)


# ============================================================
# 27. FINAL SUMMARY
# ============================================================

print()
print("=" * 80)
print("GLOBAL ANALYSIS COMPLETED")
print("=" * 80)

print(
    f"Patients analysed        : "
    f"{df['patient_id'].nunique()}"
)

print(
    f"Membrane components      : "
    f"{len(df)}"
)

print(
    f"Selected clusters        : "
    f"{best_k}"
)

print(
    f"Best silhouette score    : "
    f"{best_silhouette:.4f}"
)

print()
print("Thickness groups:")
print("-" * 80)

for _, row in cluster_statistics.iterrows():

    print(
        f"{row['Thickness_Group_Name']}: "
        f"{int(row['Number_of_membranes'])} membranes "
        f"({row['Percentage_of_membranes']:.1f}%), "
        f"mean = "
        f"{row['Mean_median_thickness_nm']:.2f} nm"
    )


print()
print("OUTPUT FILES")
print("-" * 80)

print(global_file)
print(patient_file)
print(cluster_evaluation_file)
print(cluster_statistics_file)
print(cluster_centers_file)
print(patient_group_counts_file)
print(patient_group_percentages_file)
print(component_results_file)

print()
print("FIGURES")
print("-" * 80)

print(global_histogram)
print(patient_boxplot)
print(pca_raw_file)
print(silhouette_file)
print(cluster_pca_file)
print(group_boxplot_file)
print(patient_group_plot_file)

print()
print("=" * 80)